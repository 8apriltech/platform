<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmação de Presença - Mariah faz 3 Anos! 🎈</title>
    
    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <!-- Supabase JS Client (v2) -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        :root {
            /* Elegant Pink & Rose Palette */
            --pink-primary: #FF477E;
            --pink-hover: #E6336C;
            --pink-light: #FFF0F5;
            --pink-light-2: #FFE4EC;
            --pink-border: #FFB3C6;
            --pink-dark: #9F1239;
            --pink-text: #881337;
            --accent-gold: #F59E0B;
            --bebe-green: #10B981;
            --dark: #1E293B;
            --gray-100: #F8FAFC;
            --gray-200: #E2E8F0;
            --gray-300: #CBD5E1;
            --gray-600: #64748B;
            --radius-lg: 24px;
            --radius-md: 16px;
            --shadow-card: 0 20px 45px rgba(255, 71, 126, 0.12), 0 10px 20px rgba(0, 0, 0, 0.03);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #FFF5F7 0%, #FFEBF0 50%, #FAF5FF 100%);
            color: var(--dark);
            min-height: 100vh;
            padding-bottom: 60px;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient floating pink bubbles */
        .ambient-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        .bubble {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.55;
            animation: floatBubble 16s ease-in-out infinite alternate;
        }
        .b-1 { width: 340px; height: 340px; background: #FFC2D1; top: -60px; left: -60px; }
        .b-2 { width: 400px; height: 400px; background: #FFE4E6; bottom: -100px; right: -80px; animation-delay: -4s; }
        .b-3 { width: 260px; height: 260px; background: #FBCFE8; top: 35%; right: 8%; animation-delay: -8s; }

        @keyframes floatBubble {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(30px, 50px) scale(1.08); }
        }

        /* Top Navigation Bar */
        .top-nav {
            position: relative;
            z-index: 10;
            max-width: 850px;
            margin: 0 auto;
            padding: 24px 20px 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .brand {
            font-family: 'Fredoka', cursive;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--pink-dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand-icon {
            width: 38px;
            height: 38px;
            background: var(--pink-light-2);
            color: var(--pink-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(255, 71, 126, 0.2);
        }
        .nav-pills {
            display: flex;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            padding: 5px;
            border-radius: 50px;
            border: 2px solid white;
            box-shadow: 0 6px 20px rgba(255, 71, 126, 0.08);
        }
        .nav-pill {
            padding: 9px 20px;
            border-radius: 50px;
            border: none;
            background: transparent;
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--gray-600);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-pill.active {
            background: var(--pink-primary);
            color: white;
            box-shadow: 0 4px 14px rgba(255, 71, 126, 0.35);
        }
        .badge-count {
            background: var(--pink-light-2);
            color: var(--pink-dark);
            font-size: 0.78rem;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 700;
        }

        /* Container */
        .container {
            position: relative;
            z-index: 10;
            max-width: 800px;
            margin: 15px auto;
            padding: 0 20px;
        }

        /* Card Container (Sem banner de imagem para ser ultra leve) */
        .main-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(20px);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            border: 3px solid white;
            overflow: hidden;
            transition: var(--transition);
        }

        /* Content Body */
        .card-body {
            padding: 40px 45px;
        }
        @media (max-width: 600px) {
            .card-body { padding: 28px 22px; }
        }

        /* Header Title */
        .header-title {
            text-align: center;
            margin-bottom: 32px;
        }
        .header-title .age-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--pink-light);
            color: var(--pink-primary);
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 30px;
            border: 1px solid var(--pink-border);
            margin-bottom: 12px;
        }
        .header-title h1 {
            font-family: 'Fredoka', cursive;
            font-size: 2.6rem;
            font-weight: 700;
            color: var(--pink-dark);
            letter-spacing: -0.5px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .header-title p {
            color: var(--gray-600);
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Event Info Cards Grid */
        .event-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 35px;
        }
        .info-card {
            background: var(--pink-light);
            padding: 18px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 15px;
            border: 2px solid var(--pink-border);
        }
        .info-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: white;
            color: var(--pink-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(255, 71, 126, 0.15);
            flex-shrink: 0;
        }
        .info-text label {
            display: block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--pink-dark);
            font-weight: 800;
            margin-bottom: 2px;
        }
        .info-text span {
            font-family: 'Fredoka', cursive;
            font-weight: 600;
            color: var(--dark);
            font-size: 1.05rem;
            line-height: 1.3;
            display: block;
        }
        .btn-maps {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--pink-primary);
            text-decoration: none;
            background: white;
            padding: 4px 12px;
            border-radius: 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            transition: var(--transition);
            border: 1px solid var(--pink-border);
        }
        .btn-maps:hover {
            background: var(--pink-primary);
            color: white;
        }

        /* Section Titles */
        .section-heading {
            font-family: 'Fredoka', cursive;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Choice Cards (Attending vs Declined) */
        .attendance-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 30px;
        }
        .choice-card {
            position: relative;
            padding: 22px;
            border-radius: var(--radius-md);
            border: 3px solid var(--gray-200);
            background: white;
            cursor: pointer;
            text-align: center;
            transition: var(--transition);
        }
        .choice-card input[type="radio"] {
            position: absolute;
            opacity: 0;
        }
        .choice-card .icon {
            font-size: 2.2rem;
            margin-bottom: 8px;
            display: block;
            transition: transform 0.2s;
        }
        .choice-card .title {
            font-family: 'Fredoka', cursive;
            font-weight: 600;
            font-size: 1.1rem;
            display: block;
        }
        .choice-card:hover {
            border-color: var(--pink-primary);
            transform: translateY(-3px);
        }
        .choice-card.selected-yes {
            border-color: var(--bebe-green);
            background: #ECFDF5;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.2);
        }
        .choice-card.selected-yes .title { color: #065F46; }
        .choice-card.selected-no {
            border-color: var(--pink-primary);
            background: var(--pink-light);
            box-shadow: 0 8px 25px rgba(255, 71, 126, 0.18);
        }
        .choice-card.selected-no .title { color: var(--pink-dark); }

        /* Form Inputs */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }
        @media (max-width: 600px) {
            .form-grid { grid-template-columns: 1fr; }
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .form-group.full-width { grid-column: 1 / -1; }
        .form-group label {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--dark);
        }
        .form-control {
            width: 100%;
            padding: 14px 18px;
            border-radius: var(--radius-md);
            border: 2px solid var(--gray-300);
            background: white;
            font-family: inherit;
            font-size: 0.98rem;
            color: var(--dark);
            transition: var(--transition);
            outline: none;
        }
        .form-control:focus {
            border-color: var(--pink-primary);
            box-shadow: 0 0 0 4px rgba(255, 71, 126, 0.18);
        }

        /* Companion Box */
        .companion-box {
            background: var(--pink-light);
            border-radius: var(--radius-md);
            padding: 24px;
            border: 2px solid var(--pink-border);
            margin-bottom: 25px;
            animation: fadeIn 0.3s ease-out;
        }
        .companion-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 54px;
            height: 30px;
        }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: var(--gray-300);
            transition: .3s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        input:checked + .slider { background-color: var(--pink-primary); }
        input:checked + .slider:before { transform: translateX(24px); }

        .companion-inputs-container {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px dashed var(--pink-border);
        }
        .companion-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            background: white;
            padding: 16px;
            border-radius: 14px;
            border: 1.5px solid var(--pink-border);
        }
        @media (max-width: 500px) {
            .companion-row { grid-template-columns: 1fr; }
        }
        .companion-label {
            grid-column: 1 / -1;
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--pink-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 18px 24px;
            border-radius: var(--radius-md);
            border: none;
            background: linear-gradient(135deg, var(--pink-primary) 0%, var(--pink-hover) 100%);
            color: white;
            font-family: 'Fredoka', cursive;
            font-size: 1.25rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 10px 25px rgba(255, 71, 126, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 71, 126, 0.45);
        }

        /* Success Screen */
        .success-card {
            text-align: center;
            padding: 40px 20px;
            display: none;
            animation: fadeIn 0.4s ease-out;
        }
        .success-icon {
            width: 90px;
            height: 90px;
            background: #DEF7EC;
            color: var(--bebe-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            margin: 0 auto 20px auto;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.25);
        }
        .success-card h2 {
            font-family: 'Fredoka', cursive;
            font-size: 2.2rem;
            color: var(--dark);
            margin-bottom: 10px;
        }
        .success-card p {
            color: var(--gray-600);
            max-width: 520px;
            margin: 0 auto 25px auto;
            line-height: 1.6;
            font-size: 1.05rem;
        }
        .summary-box {
            background: var(--pink-light);
            border-radius: var(--radius-md);
            padding: 20px 24px;
            max-width: 480px;
            margin: 0 auto 25px auto;
            text-align: left;
            border: 2px solid var(--pink-border);
        }
        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px dashed var(--pink-border);
            font-size: 0.95rem;
        }
        .summary-item:last-child { border-bottom: none; }

        /* ---------------------------------------------------- */
        /* PASSWORD AUTH MODAL & ADMIN PANEL */
        /* ---------------------------------------------------- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }
        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }
        .pass-modal {
            background: white;
            width: 100%;
            max-width: 400px;
            border-radius: var(--radius-lg);
            padding: 35px 30px;
            text-align: center;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
            transform: scale(0.9);
            transition: var(--transition);
            border: 3px solid var(--pink-light);
        }
        .modal-overlay.active .pass-modal {
            transform: scale(1);
        }
        .pass-icon {
            width: 65px; height: 65px;
            background: var(--pink-light);
            color: var(--pink-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 16px auto;
            box-shadow: 0 6px 16px rgba(255, 71, 126, 0.25);
        }
        .pass-modal h3 {
            font-family: 'Fredoka', cursive;
            font-size: 1.5rem;
            color: var(--dark);
            margin-bottom: 8px;
        }
        .pass-modal p {
            font-size: 0.9rem;
            color: var(--gray-600);
            margin-bottom: 20px;
        }
        .pass-input {
            text-align: center;
            letter-spacing: 12px;
            font-family: 'Fredoka', cursive;
            font-size: 1.8rem;
            font-weight: 700;
            padding: 12px;
        }
        .pass-error {
            color: var(--pink-primary);
            font-size: 0.85rem;
            font-weight: 700;
            margin-top: 10px;
            display: none;
        }
        .shake {
            animation: shake 0.4s ease-in-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-10px); }
            40%, 80% { transform: translateX(10px); }
        }

        /* ADMIN VIEW */
        .admin-view {
            display: none;
            animation: fadeIn 0.3s ease-out;
        }
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
        }
        .admin-title h2 {
            font-family: 'Fredoka', cursive;
            font-size: 1.8rem;
            color: var(--dark);
        }
        .admin-title p {
            color: var(--gray-600);
            font-size: 0.9rem;
        }
        .admin-actions {
            display: flex;
            gap: 10px;
        }
        .btn-export {
            padding: 10px 18px;
            background: var(--pink-primary);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
        }
        .btn-export:hover { background: var(--pink-hover); }
        
        .btn-lock {
            padding: 10px 14px;
            background: var(--gray-200);
            color: var(--gray-600);
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
        }
        .btn-lock:hover { background: var(--pink-light); color: var(--pink-primary); }

        /* Metrics */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-bottom: 25px;
        }
        .metric-card {
            background: white;
            padding: 20px;
            border-radius: var(--radius-md);
            border: 2px solid var(--gray-200);
            box-shadow: 0 4px 14px rgba(0,0,0,0.02);
        }
        .metric-card .num {
            font-family: 'Fredoka', cursive;
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--pink-primary);
            line-height: 1;
            margin-bottom: 6px;
        }
        .metric-card .lbl {
            font-size: 0.85rem;
            color: var(--gray-600);
            font-weight: 700;
        }

        /* Supabase Connection Status Banner */
        .supa-status-box {
            background: var(--pink-light);
            border: 2px solid var(--pink-border);
            border-radius: var(--radius-md);
            padding: 14px 18px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 0.88rem;
            color: var(--pink-dark);
        }

        /* Table & Filters */
        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }
        .search-input-wrapper {
            position: relative;
            flex: 1;
            min-width: 220px;
        }
        .search-input-wrapper i {
            position: absolute;
            left: 14px; top: 50%;
            transform: translateY(-50%);
            color: var(--gray-600);
        }
        .search-input-wrapper input { padding-left: 42px; }

        .filter-buttons { display: flex; gap: 8px; }
        .filter-btn {
            padding: 8px 16px;
            border-radius: 30px;
            border: 2px solid var(--gray-200);
            background: white;
            font-family: 'Fredoka', cursive;
            font-size: 0.9rem;
            color: var(--gray-600);
            cursor: pointer;
        }
        .filter-btn.active {
            background: var(--pink-primary);
            color: white;
            border-color: var(--pink-primary);
        }

        /* Data Table */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: var(--radius-md);
            border: 2px solid var(--gray-200);
            background: white;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.92rem;
        }
        th {
            background: var(--pink-light);
            padding: 14px 18px;
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            color: var(--pink-dark);
            border-bottom: 2px solid var(--pink-border);
            white-space: nowrap;
        }
        td {
            padding: 14px 18px;
            border-bottom: 1px solid var(--gray-200);
            color: var(--dark);
            vertical-align: top;
        }
        tr:hover td { background: #FFF9FA; }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-family: 'Fredoka', cursive;
            font-size: 0.85rem;
        }
        .badge-status.yes { background: #DEF7EC; color: #03543F; }
        .badge-status.no { background: var(--pink-light); color: var(--pink-dark); }

        .companion-pill {
            display: inline-block;
            background: var(--pink-light);
            color: var(--pink-dark);
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 8px;
            font-size: 0.82rem;
            margin-right: 4px;
            margin-bottom: 4px;
            border: 1px solid var(--pink-border);
        }
        .action-btn-del {
            background: none;
            border: none;
            color: var(--pink-primary);
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 8px;
            transition: var(--transition);
        }
        .action-btn-del:hover { background: var(--pink-light); }
    </style>
</head>
<body>

    <!-- Ambient background floating pink bubbles -->
    <div class="ambient-bg">
        <div class="bubble b-1"></div>
        <div class="bubble b-2"></div>
        <div class="bubble b-3"></div>
    </div>

    <!-- Top Navigation Bar -->
    <nav class="top-nav">
        <div class="brand">
            <div class="brand-icon"><i class="fa-solid fa-heart"></i></div>
            <span>Mariah faz 3!</span>
        </div>
        <div class="nav-pills">
            <button class="nav-pill active" id="pill-rsvp" onclick="switchView('rsvp')">
                <i class="fa-solid fa-envelope-open-text"></i> RSVP
            </button>
            <button class="nav-pill" id="pill-admin" onclick="triggerAdminAccess()">
                <i class="fa-solid fa-lock"></i> Painel dos Pais
                <span class="badge-count" id="nav-count-badge">0</span>
            </button>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container">
        <div class="main-card">
            
            <!-- ---------------------------------------------------- -->
            <!-- GUEST RSVP VIEW -->
            <!-- ---------------------------------------------------- -->
            <div id="view-rsvp">
                <div class="card-body">
                    
                    <!-- Header Title & Badge -->
                    <div class="header-title">
                        <div class="age-badge">
                            <i class="fa-solid fa-crown"></i> 3 Aninhos de Muita Alegria
                        </div>
                        <h1>
                            <span>Aniversário da Mariah</span>
                            <span style="color: var(--pink-primary);">💕✨</span>
                        </h1>
                        <p>Você é nosso convidado especial para celebrar este dia tão mágico!</p>
                    </div>

                    <!-- Event Quick Info Grid -->
                    <div class="event-info-grid">
                        <div class="info-card">
                            <div class="info-icon"><i class="fa-regular fa-calendar-heart"></i></div>
                            <div class="info-text">
                                <label>Data & Hora</label>
                                <span>19/09/2026 às 19:00</span>
                            </div>
                        </div>
                        <div class="info-card">
                            <div class="info-icon"><i class="fa-solid fa-utensils"></i></div>
                            <div class="info-text">
                                <label>Local</label>
                                <span>Restaurante Estilo Minas</span>
                                <a href="https://www.google.com/maps/search/?api=1&query=Restaurante+Estilo+Minas+Rua+Agenor+Braga+de+Araujo+125+Araxa+MG" target="_blank" class="btn-maps">
                                    <i class="fa-solid fa-map-pin"></i> Ver no Mapa
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- RSVP FORM -->
                    <form id="rsvp-form" onsubmit="handleFormSubmit(event)">
                        
                        <!-- Attendance Selection -->
                        <div class="section-heading">
                            <i class="fa-solid fa-face-smile-beam" style="color: var(--pink-primary);"></i>
                            <span>Você poderá comparecer?</span>
                        </div>
                        
                        <div class="attendance-options">
                            <label class="choice-card selected-yes" id="card-yes" onclick="selectAttendance('yes')">
                                <input type="radio" name="attending" value="yes" checked>
                                <span class="icon">🥳</span>
                                <span class="title">Sim! Com certeza</span>
                            </label>
                            <label class="choice-card" id="card-no" onclick="selectAttendance('no')">
                                <input type="radio" name="attending" value="no">
                                <span class="icon">😢</span>
                                <span class="title">Infelizmente não</span>
                            </label>
                        </div>

                        <!-- Main Guest Inputs -->
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="first-name">Seu Nome *</label>
                                <input type="text" id="first-name" class="form-control" placeholder="Ex: Rudge" required>
                            </div>
                            <div class="form-group">
                                <label for="last-name">Seu Sobrenome *</label>
                                <input type="text" id="last-name" class="form-control" placeholder="Ex: Santana" required>
                            </div>
                            <div class="form-group full-width">
                                <label for="phone">WhatsApp / Celular (Opcional)</label>
                                <input type="tel" id="phone" class="form-control" placeholder="(34) 99999-9999">
                            </div>
                        </div>

                        <!-- Companion Section (Dynamic) -->
                        <div class="companion-box" id="companion-section">
                            <div class="companion-toggle">
                                <div>
                                    <strong style="font-family: 'Fredoka'; font-size: 1.1rem; color: var(--dark);">Terá acompanhantes?</strong>
                                    <div style="font-size: 0.88rem; color: var(--gray-600);">Esposo(a), filhos, namorado(a), etc.</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="has-companions" onchange="toggleCompanions(this.checked)">
                                    <span class="slider"></span>
                                </label>
                            </div>

                            <!-- Companion Quantity & Inputs -->
                            <div id="companion-details" style="display: none;">
                                <div class="form-group" style="margin-bottom: 15px;">
                                    <label for="companion-count">Quantos acompanhantes?</label>
                                    <select id="companion-count" class="form-control" style="width: auto; display: inline-block;" onchange="renderCompanionInputs(this.value)">
                                        <option value="1">1 Acompanhante</option>
                                        <option value="2">2 Acompanhantes</option>
                                        <option value="3">3 Acompanhantes</option>
                                        <option value="4">4 Acompanhantes</option>
                                        <option value="5">5 Acompanhantes</option>
                                    </select>
                                </div>

                                <div class="companion-inputs-container" id="companion-inputs">
                                    <!-- Dynamic Rows -->
                                </div>
                            </div>
                        </div>

                        <!-- Notes / Message -->
                        <div class="form-group full-width" style="margin-bottom: 30px;">
                            <label for="notes">Deixe um recadinho carinhoso para a Mariah! 💕 (Opcional)</label>
                            <textarea id="notes" class="form-control" rows="2" placeholder="Escreva sua mensagem..."></textarea>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-submit" id="btn-submit-form">
                            <span>Confirmar Presença</span>
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>

                    <!-- SUCCESS SCREEN -->
                    <div class="success-card" id="success-screen">
                        <div class="success-icon">
                            <i class="fa-solid fa-heart"></i>
                        </div>
                        <h2 id="success-title">Presença Confirmada! 🎈</h2>
                        <p id="success-desc">Muito obrigado! Sua confirmação foi salva com sucesso. Esperamos por você para celebrar os 3 aninhos da Mariah!</p>
                        
                        <div class="summary-box" id="summary-details"></div>

                        <button class="btn-submit" style="width: auto; margin: 0 auto;" onclick="resetForm()">
                            <i class="fa-solid fa-rotate-left"></i> Enviar outra confirmação
                        </button>
                    </div>
                </div>
            </div>

            <!-- ---------------------------------------------------- -->
            <!-- ADMIN DASHBOARD VIEW ("Painel dos Pais") -->
            <!-- ---------------------------------------------------- -->
            <div id="view-admin" class="admin-view">
                <div class="card-body">
                    
                    <div class="admin-header">
                        <div class="admin-title">
                            <h2><i class="fa-solid fa-shield-heart" style="color: var(--pink-primary);"></i> Confirmados - Aniversário Mariah</h2>
                            <p>Área restrita dos Pais para controle de convidados.</p>
                        </div>
                        <div class="admin-actions">
                            <button class="btn-export" onclick="exportToCSV()">
                                <i class="fa-solid fa-file-csv"></i> Exportar CSV
                            </button>
                            <button class="btn-lock" title="Sair da Área Restrita" onclick="lockAdmin()">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Supabase Connection Banner -->
                    <div class="supa-status-box" id="supa-status-banner">
                        <div>
                            <i class="fa-solid fa-database"></i>
                            <span id="supa-status-text">Conexão Ativa: Dados gravados no Supabase / LocalStorage</span>
                        </div>
                        <span class="badge-count" style="background: white; color: var(--pink-dark);" id="storage-mode-label">LOCAL / SUPABASE</span>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="metrics-grid">
                        <div class="metric-card">
                            <div class="num" id="stat-total-people">0</div>
                            <div class="lbl">Total de Pessoas</div>
                        </div>
                        <div class="metric-card">
                            <div class="num" id="stat-confirmed-groups" style="color: var(--bebe-green);">0</div>
                            <div class="lbl">Convites Confirmados</div>
                        </div>
                        <div class="metric-card">
                            <div class="num" id="stat-companions-count" style="color: #9333EA;">0</div>
                            <div class="lbl">Acompanhantes</div>
                        </div>
                        <div class="metric-card">
                            <div class="num" id="stat-declined" style="color: var(--pink-primary);">0</div>
                            <div class="lbl">Não Poderão Ir</div>
                        </div>
                    </div>

                    <!-- Toolbar -->
                    <div class="table-toolbar">
                        <div class="search-input-wrapper">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="table-search" class="form-control" placeholder="Buscar convidado por nome..." oninput="filterTable()">
                        </div>
                        <div class="filter-buttons">
                            <button class="filter-btn active" id="filter-all" onclick="setFilter('all')">Todos</button>
                            <button class="filter-btn" id="filter-yes" onclick="setFilter('yes')">Confirmados</button>
                            <button class="filter-btn" id="filter-no" onclick="setFilter('no')">Recusados</button>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Convidado Principal</th>
                                    <th>Status</th>
                                    <th>Acompanhantes</th>
                                    <th>Contato</th>
                                    <th>Data Envio</th>
                                    <th style="text-align: right;">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                <!-- Rows -->
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- ---------------------------------------------------- -->
    <!-- PASSWORD AUTH MODAL -->
    <!-- ---------------------------------------------------- -->
    <div class="modal-overlay" id="pass-modal-overlay">
        <div class="pass-modal" id="pass-modal-card">
            <div class="pass-icon"><i class="fa-solid fa-key"></i></div>
            <h3>Área dos Pais</h3>
            <p>Digite a senha de acesso para visualizar a lista de confirmados.</p>
            
            <form onsubmit="verifyPassword(event)">
                <input type="password" id="pass-code-input" class="form-control pass-input" maxlength="4" placeholder="••••" required autofocus>
                <div class="pass-error" id="pass-error-msg">Senha incorreta! Tente novamente.</div>
                
                <button type="submit" class="btn-submit" style="margin-top: 18px; padding: 12px 20px; font-size: 1.05rem;">
                    <span>Entrar no Painel</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- JS Logic & Supabase Integration -->
    <script>
        // ====================================================
        // CONFIGURAÇÃO DO SUPABASE (COLOQUE SUAS CHAVES AQUI SE DESEJAR)
        // ====================================================
        const SUPABASE_URL = window.SUPABASE_URL || 'https://exrvjejlhtdjdhcuzwth.supabase.co';
        const SUPABASE_ANON_KEY = window.SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4cnZqZWpsaHRkamRoY3V6d3RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA0MTk2NDQsImV4cCI6MjA4NTk5NTY0NH0.Jd_gn8bvcDyw5RjiXIL5FePT6mTg6B1tDbBKw-hRakc';
        const ADMIN_PASSWORD = '1509';

        let supabaseClient = null;
        if (SUPABASE_URL && SUPABASE_ANON_KEY && window.supabase) {
            try {
                supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            } catch (e) {
                console.warn('Erro ao inicializar Supabase:', e);
            }
        }

        // Dummy Initial Dataset if LocalStorage is empty
        const DUMMY_DATA = [
            {
                id: '1',
                nome: 'Rodrigo',
                sobrenome: 'Santana',
                telefone: '(34) 99999-1509',
                vai_comparecer: true,
                acompanhantes: [
                    { nome: 'Mariana', sobrenome: 'Santana' },
                    { nome: 'Pedro', sobrenome: 'Santana' }
                ],
                mensagem: 'Mal podemos esperar pela festa da Mariah!',
                created_at: new Date().toISOString()
            },
            {
                id: '2',
                nome: 'Lucas',
                sobrenome: 'Ferreira',
                telefone: '(34) 99888-7766',
                vai_comparecer: true,
                acompanhantes: [
                    { nome: 'Ana', sobrenome: 'Ferreira' }
                ],
                mensagem: 'Parabéns Mariah! 🎉',
                created_at: new Date(Date.now() - 3600000 * 5).toISOString()
            }
        ];

        let currentFilter = 'all';
        let isAdminAuthenticated = false;

        // ----------------------------------------------------
        // INITIALIZATION
        // ----------------------------------------------------
        document.addEventListener('DOMContentLoaded', async () => {
            if (!localStorage.getItem('rsvp_mariah_local')) {
                localStorage.setItem('rsvp_mariah_local', JSON.stringify(DUMMY_DATA));
            }

            // Check session auth
            if (sessionStorage.getItem('admin_authenticated') === 'true') {
                isAdminAuthenticated = true;
            }

            await loadDataAndUpdateStats();
        });

        async function fetchRecords() {
            if (supabaseClient) {
                try {
                    const { data, error } = await supabaseClient
                        .from('rsvp_presencas')
                        .select('*')
                        .order('created_at', { ascending: false });

                    if (!error && data) return data;
                } catch (err) {
                    console.warn('Fallback para LocalStorage devido a erro no Supabase:', err);
                }
            }
            return JSON.parse(localStorage.getItem('rsvp_mariah_local') || '[]');
        }

        async function loadDataAndUpdateStats() {
            const records = await fetchRecords();
            let totalConfirmedPeople = 0;
            records.forEach(r => {
                const isYes = r.vai_comparecer === true || r.vai_comparecer === 'true' || r.attending === 'yes';
                if (isYes) {
                    const compCount = r.acompanhantes ? r.acompanhantes.length : (r.companions ? r.companions.length : 0);
                    totalConfirmedPeople += 1 + compCount;
                }
            });
            document.getElementById('nav-count-badge').textContent = totalConfirmedPeople;
        }

        // ----------------------------------------------------
        // ADMIN AUTHENTICATION
        // ----------------------------------------------------
        function triggerAdminAccess() {
            if (isAdminAuthenticated) {
                switchView('admin');
            } else {
                openPassModal();
            }
        }

        function openPassModal() {
            const overlay = document.getElementById('pass-modal-overlay');
            const passInput = document.getElementById('pass-code-input');
            const errorMsg = document.getElementById('pass-error-msg');
            
            passInput.value = '';
            errorMsg.style.display = 'none';
            overlay.classList.add('active');
            setTimeout(() => passInput.focus(), 150);
        }

        function closePassModal() {
            document.getElementById('pass-modal-overlay').classList.remove('active');
        }

        function verifyPassword(event) {
            event.preventDefault();
            const passInput = document.getElementById('pass-code-input');
            const card = document.getElementById('pass-modal-card');
            const errorMsg = document.getElementById('pass-error-msg');

            if (passInput.value === ADMIN_PASSWORD) {
                isAdminAuthenticated = true;
                sessionStorage.setItem('admin_authenticated', 'true');
                closePassModal();
                switchView('admin');
            } else {
                card.classList.add('shake');
                errorMsg.style.display = 'block';
                passInput.value = '';
                setTimeout(() => card.classList.remove('shake'), 400);
            }
        }

        function lockAdmin() {
            isAdminAuthenticated = false;
            sessionStorage.removeItem('admin_authenticated');
            switchView('rsvp');
        }

        // ----------------------------------------------------
        // VIEW SWITCHER
        // ----------------------------------------------------
        function switchView(view) {
            const rsvpView = document.getElementById('view-rsvp');
            const adminView = document.getElementById('view-admin');
            const pillRsvp = document.getElementById('pill-rsvp');
            const pillAdmin = document.getElementById('pill-admin');

            if (view === 'rsvp') {
                rsvpView.style.display = 'block';
                adminView.style.display = 'none';
                pillRsvp.classList.add('active');
                pillAdmin.classList.remove('active');
            } else {
                if (!isAdminAuthenticated) {
                    openPassModal();
                    return;
                }
                rsvpView.style.display = 'none';
                adminView.style.display = 'block';
                pillAdmin.classList.add('active');
                pillRsvp.classList.remove('active');
                renderTable();
            }
        }

        // ----------------------------------------------------
        // RSVP FORM CONTROLS
        // ----------------------------------------------------
        function selectAttendance(value) {
            const cardYes = document.getElementById('card-yes');
            const cardNo = document.getElementById('card-no');
            const companionSection = document.getElementById('companion-section');

            if (value === 'yes') {
                cardYes.querySelector('input').checked = true;
                cardYes.className = 'choice-card selected-yes';
                cardNo.className = 'choice-card';
                companionSection.style.display = 'block';
            } else {
                cardNo.querySelector('input').checked = true;
                cardNo.className = 'choice-card selected-no';
                cardYes.className = 'choice-card';
                companionSection.style.display = 'none';
            }
        }

        function toggleCompanions(checked) {
            const details = document.getElementById('companion-details');
            details.style.display = checked ? 'block' : 'none';
            if (checked) {
                renderCompanionInputs(document.getElementById('companion-count').value);
            }
        }

        function renderCompanionInputs(count) {
            const container = document.getElementById('companion-inputs');
            container.innerHTML = '';
            const num = parseInt(count, 10) || 1;

            for (let i = 1; i <= num; i++) {
                const row = document.createElement('div');
                row.className = 'companion-row';
                row.innerHTML = `
                    <div class="companion-label">
                        <i class="fa-solid fa-user"></i> Acompanhante ${i}
                    </div>
                    <div>
                        <input type="text" class="form-control companion-fn" placeholder="Nome" required>
                    </div>
                    <div>
                        <input type="text" class="form-control companion-ln" placeholder="Sobrenome" required>
                    </div>
                `;
                container.appendChild(row);
            }
        }

        // ----------------------------------------------------
        // FORM SUBMIT & SUPABASE SAVE
        // ----------------------------------------------------
        async function handleFormSubmit(event) {
            event.preventDefault();

            const submitBtn = document.getElementById('btn-submit-form');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Salvando...`;

            const attending = document.querySelector('input[name="attending"]:checked').value === 'yes';
            const firstName = document.getElementById('first-name').value.trim();
            const lastName = document.getElementById('last-name').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const hasCompanions = attending && document.getElementById('has-companions').checked;
            const notes = document.getElementById('notes').value.trim();

            let companionsArr = [];
            if (hasCompanions) {
                const fnInputs = document.querySelectorAll('.companion-fn');
                const lnInputs = document.querySelectorAll('.companion-ln');
                fnInputs.forEach((input, index) => {
                    const fn = input.value.trim();
                    const ln = lnInputs[index] ? lnInputs[index].value.trim() : '';
                    if (fn) {
                        companionsArr.push({ nome: fn, sobrenome: ln });
                    }
                });
            }

            const dbPayload = {
                nome: firstName,
                sobrenome: lastName,
                telefone: phone,
                vai_comparecer: attending,
                acompanhantes: companionsArr,
                mensagem: notes
            };

            const record = {
                id: Date.now().toString(),
                ...dbPayload,
                created_at: new Date().toISOString()
            };

            // Save to Supabase or LocalStorage
            let savedInSupabase = false;
            if (supabaseClient) {
                try {
                    const { error } = await supabaseClient
                        .from('rsvp_presencas')
                        .insert([dbPayload]);
                    if (error) {
                        console.error('Erro no Supabase:', error.message || error);
                    } else {
                        savedInSupabase = true;
                    }
                } catch (e) {
                    console.warn('Erro ao salvar no Supabase:', e);
                }
            }

            // Always back up to LocalStorage
            const localData = JSON.parse(localStorage.getItem('rsvp_mariah_local') || '[]');
            localData.unshift(record);
            localStorage.setItem('rsvp_mariah_local', JSON.stringify(localData));

            await loadDataAndUpdateStats();

            // Confetti
            if (attending && typeof confetti === 'function') {
                confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
            }

            // Show Success Screen
            document.getElementById('rsvp-form').style.display = 'none';
            const successScreen = document.getElementById('success-screen');
            const summaryDetails = document.getElementById('summary-details');

            if (attending) {
                document.getElementById('success-title').textContent = 'Presença Confirmada! 🎈';
                document.getElementById('success-desc').textContent = `Ficamos muito felizes, ${firstName}! Sua resposta foi gravada com sucesso.`;
                
                let compNames = companionsArr.length > 0 
                    ? companionsArr.map(c => `${c.nome} ${c.sobrenome}`).join(', ') 
                    : 'Nenhum acompanhante';

                summaryDetails.innerHTML = `
                    <div class="summary-item"><strong>Convidado:</strong> <span>${firstName} ${lastName}</span></div>
                    <div class="summary-item"><strong>Status:</strong> <span style="color: var(--bebe-green); font-weight:700;">Confirmado 🟢</span></div>
                    <div class="summary-item"><strong>Acompanhantes (${companionsArr.length}):</strong> <span>${compNames}</span></div>
                    ${phone ? `<div class="summary-item"><strong>Contato:</strong> <span>${phone}</span></div>` : ''}
                `;
            } else {
                document.getElementById('success-title').textContent = 'Resposta Registrada 💌';
                document.getElementById('success-desc').textContent = `Obrigado por avisar, ${firstName}! Sentiremos sua falta.`;
                summaryDetails.innerHTML = `
                    <div class="summary-item"><strong>Convidado:</strong> <span>${firstName} ${lastName}</span></div>
                    <div class="summary-item"><strong>Status:</strong> <span style="color: var(--pink-primary); font-weight:700;">Não irá 🔴</span></div>
                `;
            }

            successScreen.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Confirmar Presença</span> <i class="fa-solid fa-paper-plane"></i>`;
        }

        function resetForm() {
            document.getElementById('rsvp-form').reset();
            document.getElementById('rsvp-form').style.display = 'block';
            document.getElementById('success-screen').style.display = 'none';
            selectAttendance('yes');
            toggleCompanions(false);
        }

        // ----------------------------------------------------
        // ADMIN DASHBOARD RENDER & TABLE
        // ----------------------------------------------------
        async function renderTable() {
            const records = await fetchRecords();
            const tbody = document.getElementById('table-body');
            const searchVal = document.getElementById('table-search').value.toLowerCase();

            let totalPeople = 0;
            let confirmedGroups = 0;
            let companionsCount = 0;
            let declinedCount = 0;

            records.forEach(r => {
                const isYes = r.vai_comparecer === true || r.vai_comparecer === 'true' || r.attending === 'yes';
                if (isYes) {
                    confirmedGroups++;
                    const comp = r.acompanhantes || r.companions || [];
                    companionsCount += comp.length;
                    totalPeople += (1 + comp.length);
                } else {
                    declinedCount++;
                }
            });

            document.getElementById('stat-total-people').textContent = totalPeople;
            document.getElementById('stat-confirmed-groups').textContent = confirmedGroups;
            document.getElementById('stat-companions-count').textContent = companionsCount;
            document.getElementById('stat-declined').textContent = declinedCount;

            const filtered = records.filter(r => {
                const fn = r.nome || r.firstName || '';
                const ln = r.sobrenome || r.lastName || '';
                const fullName = `${fn} ${ln}`.toLowerCase();
                const phone = r.telefone || r.phone || '';
                const matchesSearch = fullName.includes(searchVal) || phone.includes(searchVal);
                const isYes = r.vai_comparecer === true || r.vai_comparecer === 'true' || r.attending === 'yes';

                if (currentFilter === 'yes') return matchesSearch && isYes;
                if (currentFilter === 'no') return matchesSearch && !isYes;
                return matchesSearch;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--gray-600);">
                            <i class="fa-solid fa-inbox" style="font-size: 2rem; margin-bottom: 8px; color: var(--gray-300);"></i><br>
                            Nenhum registro encontrado.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map(r => {
                const fn = r.nome || r.firstName || '';
                const ln = r.sobrenome || r.lastName || '';
                const phone = r.telefone || r.phone || '';
                const msg = r.mensagem || r.notes || '';
                const comp = r.acompanhantes || r.companions || [];
                const isYes = r.vai_comparecer === true || r.vai_comparecer === 'true' || r.attending === 'yes';

                const dateFormatted = new Date(r.created_at || r.createdAt).toLocaleDateString('pt-BR', {
                    day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'
                });

                const statusBadge = isYes
                    ? `<span class="badge-status yes"><i class="fa-solid fa-check"></i> Sim (${1 + comp.length} pes.)</span>`
                    : `<span class="badge-status no"><i class="fa-solid fa-xmark"></i> Não vai</span>`;

                let compHtml = '<span style="color: var(--gray-600);">-</span>';
                if (isYes && comp.length > 0) {
                    compHtml = comp.map(c => 
                        `<span class="companion-pill"><i class="fa-solid fa-user-tag"></i> ${escapeHtml(c.nome || c.firstName)} ${escapeHtml(c.sobrenome || c.lastName)}</span>`
                    ).join('');
                }

                return `
                    <tr>
                        <td>
                            <strong>${escapeHtml(fn)} ${escapeHtml(ln)}</strong>
                            ${msg ? `<div style="font-size: 0.8rem; color: var(--gray-600); margin-top: 4px;"><em>"${escapeHtml(msg)}"</em></div>` : ''}
                        </td>
                        <td>${statusBadge}</td>
                        <td>${compHtml}</td>
                        <td>${phone ? escapeHtml(phone) : '<span style="color: var(--gray-600);">-</span>'}</td>
                        <td style="font-size: 0.85rem; color: var(--gray-600);">${dateFormatted}</td>
                        <td style="text-align: right;">
                            <button class="action-btn-del" title="Excluir" onclick="deleteRecord('${r.id}')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function deleteRecord(id) {
            if (confirm('Deseja realmente remover esta resposta?')) {
                if (supabaseClient) {
                    try {
                        await supabaseClient.from('rsvp_presencas').delete().eq('id', id);
                    } catch(e) {}
                }
                const localData = JSON.parse(localStorage.getItem('rsvp_mariah_local') || '[]').filter(r => r.id !== id);
                localStorage.setItem('rsvp_mariah_local', JSON.stringify(localData));
                await loadDataAndUpdateStats();
                renderTable();
            }
        }

        function setFilter(filter) {
            currentFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`filter-${filter}`).classList.add('active');
            renderTable();
        }

        function filterTable() { renderTable(); }

        async function exportToCSV() {
            const records = await fetchRecords();
            if (records.length === 0) {
                alert('Sem dados para exportar.');
                return;
            }

            let csv = 'Nome,Sobrenome,Status,Qtd Acompanhantes,Nomes Acompanhantes,Telefone,Mensagem,Data\n';
            records.forEach(r => {
                const fn = r.nome || r.firstName || '';
                const ln = r.sobrenome || r.lastName || '';
                const isYes = r.vai_comparecer === true || r.vai_comparecer === 'true' || r.attending === 'yes';
                const comp = r.acompanhantes || r.companions || [];
                const compNames = comp.map(c => `${c.nome || c.firstName} ${c.sobrenome || c.lastName}`).join(' | ');
                const msg = (r.mensagem || r.notes || '').replace(/"/g, '""');

                csv += `"${fn}","${ln}","${isYes ? 'Confirmado' : 'Recusado'}","${comp.length}","${compNames}","${r.telefone || r.phone || ''}","${msg}","${r.created_at || r.createdAt}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', `confirmados_mariah_3anos_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
